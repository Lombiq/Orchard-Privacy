@inject OrchardCore.Settings.ISiteService SiteService

@{
    var registrationConsentText = (await SiteService.GetSiteSettingsAsync())
        .As<ContentItem>(TypeNames.PrivacyRegistrationConsentSettings).GetOrCreate<LiquidPart>()?.Liquid;
}

@await Orchard.LiquidToHtmlAsync(registrationConsentText)
