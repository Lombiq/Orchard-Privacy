<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <DefaultItemExcludes>$(DefaultItemExcludes);.git*</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Lombiq Privacy for Orchard Core</Title>
    <Authors>Lombiq Technologies</Authors>
    <Copyright>Copyright © 2018, Lombiq Technologies Ltd.</Copyright>
    <Description>Lombiq Privacy for Orchard Core: Orchard module containing features related to data protection/privacy and the EU law on it, the General Data Protection Regulation (GDPR). See the project website for detailed documentation.</Description>
    <PackageIcon>NuGetIcon.png</PackageIcon>
    <PackageTags>OrchardCore;Lombiq;AspNetCore;GDPR;Privacy</PackageTags>
    <RepositoryUrl>https://github.com/Lombiq/Orchard-Privacy</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Lombiq/Orchard-Privacy</PackageProjectUrl>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Readme.md" />
    <None Include="NuGetIcon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.CustomSettings" Version="3.0.0-preview-18971" />
    <PackageReference Include="OrchardCore.Forms" Version="3.0.0-preview-18971" />
    <PackageReference Include="OrchardCore.Liquid" Version="3.0.0-preview-18971" />
    <PackageReference Include="OrchardCore.Module.Targets" Version="3.0.0-preview-18971" />
    <PackageReference Include="OrchardCore.ContentManagement" Version="3.0.0-preview-18971" />
    <PackageReference Include="OrchardCore.ContentTypes.Abstractions" Version="3.0.0-preview-18971" />
    <PackageReference Include="OrchardCore.DisplayManagement" Version="3.0.0-preview-18971" />
    <PackageReference Include="OrchardCore.Navigation" Version="3.0.0-preview-18971" />
    <PackageReference Include="OrchardCore.Users" Version="3.0.0-preview-18971" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' != 'true'">
    <ProjectReference Include="..\..\..\Libraries\Lombiq.HelpfulLibraries\Lombiq.HelpfulLibraries.OrchardCore\Lombiq.HelpfulLibraries.OrchardCore.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuGetBuild)' == 'true'">
    <PackageReference Include="Lombiq.HelpfulLibraries.OrchardCore" Version="12.6.1-alpha.5.osoe-925" />
  </ItemGroup>

</Project>
